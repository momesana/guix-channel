From 649f0654c598b2e8075a3b9f815fa693f4a171fe Mon Sep 17 00:00:00 2001
From: Adam Curtis <adam.curtis.dev@gmail.com>
Date: Sun, 18 Oct 2026 17:45:20 -0700
Subject: [PATCH 2/3] redir: fix non-SSL connections

Adds sslinitplain for -P (plaintext) connections.

In redir_connect, calls sslinitplain when r->ssl == NULL.

Signed-off-by: Adam Curtis <adam.curtis.dev@gmail.com>
---
 redir.c | 2 ++
 ssl.c   | 5 +++++
 ssl.h   | 1 +
 3 files changed, 8 insertions(+)

diff --git a/redir.c b/redir.c
index 4b2d24e..5f699ad 100644
--- a/redir.c
+++ b/redir.c
@@ -162,6 +162,8 @@ int redir_connect(struct redir *r)
 			  strlen(r->port) ? r->port : defport);
     if (r->ssl)
 	r->ctx = sslinit(r->sock, r->cacert);
+    else
+	r->ctx = sslinitplain(r->sock);
     if(r->ctx == NULL) {
 	close(r->sock);
 	r->sock = -1;
diff --git a/ssl.c b/ssl.c
index 127b563..584bc9c 100644
--- a/ssl.c
+++ b/ssl.c
@@ -61,6 +61,11 @@ static struct ctx *newctx(int fd)
 	return ctx;
 }
 
+struct ctx *sslinitplain(int fd)
+{
+	return newctx(fd);
+}
+
 #if defined(USE_OPENSSL)
 
 struct ctx *sslinit(int fd,char *cacert)
diff --git a/ssl.h b/ssl.h
index 19c0d58..42bc1ee 100644
--- a/ssl.h
+++ b/ssl.h
@@ -1,5 +1,6 @@
 struct ctx;
 
+extern struct ctx *sslinitplain(int fd);
 extern struct ctx *sslinit(int fd,char *cacert);
 extern void sslexit(struct ctx *ctx);
 extern int sslready(struct ctx *ctx);
-- 
