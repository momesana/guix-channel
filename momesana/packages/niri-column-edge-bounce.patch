+
+fn make_edge_bounce_layout(off: bool) -> Layout<TestWindow> {
+    let mut options = make_options();
+    options.animations.column_edge_bounce.0.kind = Kind::Easing(EasingParams {
+        duration_ms: 1000,
+        curve: Curve::Linear,
+    });
+    options.animations.column_edge_bounce.0.off = off;
+
+    let ops = [
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams::new(2),
+        },
+        Op::CompleteAnimations,
+    ];
+
+    check_ops_with_options(options, ops)
+}
+
+fn view_pos(layout: &Layout<TestWindow>) -> f64 {
+    layout.active_workspace().unwrap().scrolling().view_pos()
+}
+
+fn active_column_idx(layout: &Layout<TestWindow>) -> usize {
+    let ws = layout.active_workspace().unwrap();
+    ws.scrolling().active_column_idx()
+}
+
+#[track_caller]
+fn assert_stretch(layout: &Layout<TestWindow>, start: f64, stretch: f64) {
+    let actual = view_pos(layout) - start;
+    assert!(
+        (actual - stretch).abs() < 0.01,
+        "expected stretch {stretch}, got {actual}"
+    );
+}
+
+#[test]
+fn focus_past_last_column_bounces() {
+    let mut layout = make_edge_bounce_layout(false);
+    let start = view_pos(&layout);
+    let col = active_column_idx(&layout);
+
+    check_ops_on_layout(&mut layout, [Op::FocusColumnRight]);
+    assert_eq!(active_column_idx(&layout), col);
+
+    // Stretches out with an ease-out cubic over 100 ms.
+    check_ops_on_layout(&mut layout, [Op::AdvanceAnimations { msec_delta: 50 }]);
+    assert_stretch(&layout, start, 48. * (1. - 0.5f64.powi(3)));
+    check_ops_on_layout(&mut layout, [Op::AdvanceAnimations { msec_delta: 50 }]);
+    assert_stretch(&layout, start, 48.);
+
+    // Then bounces back with column-edge-bounce.
+    check_ops_on_layout(&mut layout, [Op::AdvanceAnimations { msec_delta: 500 }]);
+    assert_stretch(&layout, start, 24.);
+    check_ops_on_layout(&mut layout, [Op::AdvanceAnimations { msec_delta: 500 }]);
+    assert_eq!(view_pos(&layout), start);
+    assert!(!layout.are_animations_ongoing(None));
+}
+
+#[test]
+fn focus_past_first_column_bounces() {
+    let mut layout = make_edge_bounce_layout(false);
+    check_ops_on_layout(&mut layout, [Op::FocusColumnLeft, Op::CompleteAnimations]);
+    let start = view_pos(&layout);
+
+    check_ops_on_layout(&mut layout, [Op::FocusColumnLeft]);
+    assert_eq!(active_column_idx(&layout), 0);
+
+    check_ops_on_layout(&mut layout, [Op::AdvanceAnimations { msec_delta: 100 }]);
+    assert_stretch(&layout, start, -48.);
+    check_ops_on_layout(&mut layout, [Op::AdvanceAnimations { msec_delta: 1000 }]);
+    assert_eq!(view_pos(&layout), start);
+}
+
+#[test]
+fn move_past_last_column_bounces() {
+    let mut layout = make_edge_bounce_layout(false);
+    let start = view_pos(&layout);
+
+    check_ops_on_layout(
